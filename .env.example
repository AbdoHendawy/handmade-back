# Copy to .env and adjust locally. Do not commit .env.

# --- Compose: PostgreSQL ---
POSTGRES_USER=handmade
POSTGRES_PASSWORD=handmade
POSTGRES_DB=handmade
POSTGRES_PORT=5432

# --- Compose: MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- API (required for Staging/Production; use env / secrets / user-secrets) ---
# ASPNETCORE_ENVIRONMENT=Production
# AllowedHosts=api.example.com;www.example.com
# ConnectionStrings__Default=Host=db.example.com;Port=5432;Database=handmade;Username=handmade;Password=CHANGE_ME

# Jwt__SecretKey=use-a-long-random-secret-at-least-32-chars
# Jwt__Issuer=Handmade
# Jwt__Audience=Handmade

# Cors__AllowedOrigins__0=https://app.example.com

# Google Sign-In (SPA client id)
# GoogleAuth__ClientId=your-google-oauth-client-id.apps.googleusercontent.com

# FileStorage (required outside Development)
# FileStorage__Provider=MinIO
# FileStorage__Endpoint=minio:9000
# FileStorage__UseSsl=false
# FileStorage__AccessKey=CHANGE_ME
# FileStorage__SecretKey=CHANGE_ME
# FileStorage__Bucket=handmade
# FileStorage__PublicBaseUrl=https://cdn.example.com/handmade

# Outbound email (required outside Development — Console is Development-only)
# Email__Provider=SMTP
# Email__Host=smtp.example.com
# Email__Port=587
# Email__Username=
# Email__Password=
# Email__FromAddress=noreply@example.com
# Email__FromName=Handmade
# Email__EnableSsl=true

# Hangfire
# Hangfire__Enabled=true
# Hangfire__PrepareSchemaIfNecessary=true

# Rate limiting (Staging/Production require Enabled=true and positive Auth/Catalog limits)
# RateLimiting__Enabled=true
# RateLimiting__Auth__PermitLimit=20
# RateLimiting__Auth__WindowSeconds=60
# RateLimiting__Catalog__PermitLimit=120
# RateLimiting__Catalog__WindowSeconds=60

# First Admin bootstrap (optional; Development also has a DEV_ONLY seed in appsettings.Development.json)
# AdminSeed__Enabled=true
# AdminSeed__Email=admin@localhost.local
# AdminSeed__Password=
