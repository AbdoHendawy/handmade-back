# Copy to .env and adjust locally. Do not commit .env.
POSTGRES_USER=handmade
POSTGRES_PASSWORD=handmade
POSTGRES_DB=handmade
POSTGRES_PORT=5432

# JWT (override appsettings in non-Development)
# Jwt__SecretKey=use-a-long-random-secret-at-least-32-chars
# Jwt__Issuer=Handmade
# Jwt__Audience=Handmade

# Google Sign-In (SPA client id)
# GoogleAuth__ClientId=your-google-oauth-client-id.apps.googleusercontent.com

# MinIO local object storage (compose defaults if unset)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# First Admin bootstrap (optional; Development also has a DEV_ONLY seed in appsettings.Development.json)
# AdminSeed__Enabled=true
# AdminSeed__Email=admin@localhost.local
# AdminSeed__Password=

# Outbound email (Development defaults to Console — no SMTP required)
# Email__Provider=SMTP
# Email__Host=
# Email__Port=587
# Email__Username=
# Email__Password=
# Email__FromAddress=
# Email__FromName=Handmade
# Email__EnableSsl=true
