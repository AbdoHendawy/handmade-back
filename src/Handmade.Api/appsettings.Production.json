{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "",
  "Hangfire": {
    "Enabled": true,
    "PrepareSchemaIfNecessary": true
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Catalog": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Email": {
    "Provider": "SMTP",
    "Port": 587,
    "EnableSsl": true
  },
  "FileStorage": {
    "Provider": "MinIO",
    "UseSsl": true
  }
}
